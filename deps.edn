{:paths ["src" "resources"]

 :jolt/min-version "0.8.0"

 :deps {io.github.casselc/jolt-http
        {:git/url "https://github.com/casselc/jolt-http.git"
         :git/sha "d9fa89309fb9faa3dd3e8319a79d57fc03925341"}
        io.github.casselc/http-client
        {:git/url "https://github.com/casselc/http-client.git"
         :git/sha "a42592a690000fcb749f608a94053695e467c836"}
        io.github.casselc/otel
        {:git/url "https://github.com/casselc/otel.git"
         :git/sha "b18830ae1fc6eef6add5e059ae302e94a1f0ed70"}
        io.github.chucklehead-dev/jolt-chdb
        {:git/url "https://github.com/chucklehead-dev/jolt-chdb.git"
         :git/sha "39c04ed04933fdeaa5e2f481aa8c9b294afb5e7e"}
        io.github.chucklehead-dev/jolt-otel-clickhouse
        {:git/url "https://github.com/chucklehead-dev/jolt-otel-clickhouse.git"
         :git/sha "a247f418a462357d0a114d5f51024d00bd38189f"}
        io.github.chucklehead-dev/jolt-otel-instrumentation-db
        {:git/url "https://github.com/chucklehead-dev/jolt-otel-instrumentation-db.git"
         :git/sha "eaebe2250558e6b94a2152cb245eae071d0e593c"}
        io.github.chucklehead-dev/jolt-otel-instrumentation-http-client
        {:git/url "https://github.com/chucklehead-dev/jolt-otel-instrumentation-http-client.git"
         :git/sha "158bc20e5f34dd8047a3ffabdd602bc9a68915dc"}
        io.github.chucklehead-dev/jolt-otel-instrumentation-http-server
        {:git/url "https://github.com/chucklehead-dev/jolt-otel-instrumentation-http-server.git"
         :git/sha "23a90e77406c5f4d99fa61b160c9723417ef87c0"}
        io.github.chucklehead-dev/jolt-otel-viewer
        {:git/url "https://github.com/chucklehead-dev/jolt-otel-viewer.git"
         :git/sha "9ae943fcaf7725b1b36e00bc216aef17405f295a"}
        io.github.chucklehead-dev/oscope
        {:git/url "https://github.com/chucklehead-dev/oscope.git"
         :git/sha "eb9b231b4e1743817feca76a990dc0502eb5c9ad"}
        jolt-lang/glimmer-datastar
        {:git/url "https://github.com/jolt-lang/glimmer-datastar.git"
         :git/sha "78930867485e4b6ea21da1e1a13c3e8fd828c035"}
        io.github.casselc/glimmer
        {:git/url "https://github.com/casselc/glimmer.git"
         :git/sha "6dab5597dc0d912793fe175d0d3cbb9e75f11426"}
        io.github.casselc/data.json
        {:git/url "https://github.com/casselc/data.json.git"
         :git/sha "932444043c0c06f9e295ba4963419b2481e9dd07"}}

 :jolt/build {:embed ["resources"]
              :aspects [{:resource "META-INF/jolt/aspects/demo-workbench.edn"
                         :provider demo.aspect-provider}
                        {:resource "META-INF/jolt/aspects/db-jdbc-shim.edn"
                         :provider otel.instrumentation.db}
                        {:resource "META-INF/jolt/aspects/http-client-core.edn"
                         :provider otel.instrumentation.http-client}
                        {:resource "META-INF/jolt/aspects/http-server.edn"
                         :provider otel.instrumentation.http-server}]
              :aspect-report "target/aspects.edn"}

 :aliases {:setup-native {:main-opts ["-m" "jdbc.chdb.install"]}
           :test {:extra-paths ["test"]
                  :extra-deps
                  {io.github.casselc/samizdat
                   {:git/url "https://github.com/casselc/samizdat.git"
                    :git/sha "7a72c9b52e35f4dd31daefcef2a9b3235a80e475"}
                   io.github.chucklehead-dev/jolt-hegel
                   {:git/url "https://github.com/chucklehead-dev/jolt-hegel.git"
                    :git/sha "b214f769983211431c74e427f0f35553cfba7b34"}}
                  :main-opts ["-m" "demo.test-runner"]}
           :plotje-oracle-test
           {:extra-paths ["test"]
            :replace-deps
            {io.github.scicloj/plotje
             {:git/url "https://github.com/scicloj/plotje.git"
              :git/sha "b2a9199681c4143ec1068ed02feec4e2997d50ca"}}
            :main-opts ["-m" "demo.plotje-oracle-test-runner"]}
           :threadstatus-probe
           {:extra-paths ["test"]
            :main-opts ["-m" "demo.threadstatus-probe"]}}

 :tasks {test "jolt -M:test"}}
