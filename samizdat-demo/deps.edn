{:paths []

 :deps {local/jolt-observability-demo
        {:local/root ".."}
        io.github.casselc/samizdat
        {:git/url "https://github.com/casselc/samizdat.git"
         :git/sha "7a72c9b52e35f4dd31daefcef2a9b3235a80e475"}
        io.github.chucklehead-dev/jolt-otel-viewer
        {:git/url "https://github.com/chucklehead-dev/jolt-otel-viewer.git"
         :git/sha "923ec6b5912bb1246c87d325febce70c388bab6b"}}

 ;; A standalone build embeds both applications' data resources and activates
 ;; both independently revisioned aspect manifests. The enclosing demo remains
 ;; local while it is the application being built; library inputs are exact.
 :jolt/build
 {:embed ["../resources" "../../samizdat-embed-aspects/resources"]
  :aspects [{:resource "META-INF/jolt/aspects/demo-workbench.edn"
             :provider demo.aspect-provider}
            {:resource "META-INF/jolt/aspects/db-jdbc-shim.edn"
             :provider otel.instrumentation.db}
            {:resource "META-INF/jolt/aspects/http-client-core.edn"
             :provider otel.instrumentation.http-client}
            {:resource "META-INF/jolt/aspects/http-server.edn"
             :provider otel.instrumentation.http-server}
            {:resource "META-INF/jolt/aspects/samizdat-m2-embed.edn"
             :consumers
             [{:provider demo.samizdat-journal-provider
               :roles [:samizdat/run]}
              {:provider demo.samizdat-aspect-provider
               :roles :all}]}
            {:resource "META-INF/jolt/aspects/samizdat-m2-core.edn"
             :consumers
             [{:provider demo.samizdat-journal-provider
               :roles [:samizdat/control-loop
                       :samizdat/branch-open
                       :samizdat/branch-close
                       :samizdat/turn
                       :samizdat/model
                       :samizdat/tool-selection
                       :samizdat/tool
                       :samizdat/steer]}
              {:provider demo.samizdat-aspect-provider
               :roles :all}]}]
  :aspect-report "../target/samizdat-aspects.edn"}

 :aliases {:test {:extra-paths ["../test"]}}

 :tasks {run {:main-opts ["-m" "demo.samizdat-main"]}
         build "jolt build -m demo.samizdat-main -o ../target/samizdat-observability-demo"}}
